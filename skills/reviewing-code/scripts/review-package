#!/bin/sh
set -eu

if [ "$#" -ne 2 ]; then
  echo "usage: review-package BASE HEAD" >&2
  exit 2
fi

base=$1
head=$2
root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "not inside a Git repository" >&2; exit 2; }
base_sha=$(git rev-parse --verify "${base}^{commit}" 2>/dev/null) || { echo "BASE does not resolve to a commit: $base" >&2; exit 2; }
head_sha=$(git rev-parse --verify "${head}^{commit}" 2>/dev/null) || { echo "HEAD does not resolve to a commit: $head" >&2; exit 2; }
git merge-base --is-ancestor "$base_sha" "$head_sha" || { echo "BASE is not an ancestor of HEAD" >&2; exit 2; }

package=$(mktemp "${TMPDIR:-/tmp}/review-package.XXXXXX.md")
cleanup() { rm -f "$package"; }
trap cleanup EXIT HUP INT TERM

{
  echo "# Review package"
  echo
  echo "- Repository root: \`$root\`"
  echo "- Base SHA: \`$base_sha\`"
  echo "- Head SHA: \`$head_sha\`"
  echo
  echo "## Commits"
  echo
  git log --format="- \`%H\` %s" "$base_sha..$head_sha"
  echo
  echo "## Diff stat"
  echo
  echo '```text'
  git diff --no-ext-diff --find-renames --stat "$base_sha" "$head_sha"
  echo '```'
  echo
  echo "## Full diff"
  echo
  echo '```diff'
  git diff --no-ext-diff --find-renames --unified=10 "$base_sha" "$head_sha"
  echo '```'
} > "$package"

trap - EXIT HUP INT TERM
printf '%s\n' "$package"
